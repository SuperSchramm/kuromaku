# Copy to .env (already gitignored — never commit the real file) and pass
# --env-file .env when running the orchestrator container. Every variable
# here is read from the ORCHESTRATOR's own environment and forwarded to the
# relevant worker container only when set — never hardcoded, never written
# into a checkpoint/options JSON file on disk.

# Optional. Raises vulners.nse's rate limit / result set on the webscan
# phase's nmap --script vulners run (unauthenticated tier is more limited).
# Get a key at https://vulners.com/ — forwarded to webscan via
# --script-args vulners.apikey=<key>; see phase-webscan.sh.
VULNERS_API_KEY=

# Required. Host filesystem path to the projects directory — see
# hostScanDir() in orchestrator.js / docs/DEPLOYMENT.md.
HOST_PROJECTS_DIR=

# Optional. "low" (default, tuned for ~8GB) or "high" (8GB+ dedicated to
# the webscan container) — see README's "Resource profiles" section.
RESOURCE_PROFILE=
